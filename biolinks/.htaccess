Options -Indexes

RewriteEngine On

# Serve existing files and directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send API traffic to the Node.js app when Passenger is enabled in cPanel.
RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

# Route the main app entry to the Biolinks dashboard.
RewriteRule ^$ /biolinks/index.html [L]

# Frontend assets under /biolinks are served as static files.
RewriteRule ^biolinks/(.*)$ /biolinks/$1 [L]

# Fallback all other non-file requests to the dashboard.
RewriteRule ^.*$ /biolinks/index.html [L]
