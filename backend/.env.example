# --- Database ---
# Full SQLAlchemy URL (preferred). This one matches `docker compose up -d db` at the repo root:
DATABASE_URL=postgresql+psycopg2://postgres:dev@localhost:55433/biolinks
# If DATABASE_URL is not set, these discrete vars are assembled into one instead:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=biolinks_user
# DB_PASSWORD=changeme
# DB_NAME=biolinks

# --- Auth ---
# REQUIRED, at least 32 characters. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:8080

# --- Uploads ---
UPLOAD_DIR=./uploads
# Public base URL prefixed onto returned upload URLs, e.g. https://api.biopharmlifescience.co.ke
PUBLIC_URL=

# --- Chat / RAG ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Server ---
PORT=3001

# --- API docs: true serves /docs and /openapi.json (needed for the browser-only admin setup) ---
EXPOSE_API_DOCS=false

# --- Session length (optional). Overrides JWT_EXPIRES_DAYS when set. ---
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First admin and recovery without a shell (/api/setup/*). Unset = disabled (503). ---
# Each must be 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set one only while you use it, then delete it.
SETUP_TOKEN=
ADMIN_RESET_TOKEN=

# --- Proxy ---
# true on Render: rate limits key on the client IP that Render's proxy appends to X-Forwarded-For.
TRUST_PROXY=false

# --- Error monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
