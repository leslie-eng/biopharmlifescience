# Leave empty in local dev: Vite proxies /api to http://localhost:3001.
# Staging:    https://api-staging.biopharmlifescience.co.ke
# Production: https://api.biopharmlifescience.co.ke
VITE_API_URL=

# Error monitoring (optional). Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Shows the dashboard preview on the home page. Keep off in staging and production.
VITE_SHOW_HOME_DASHBOARD=false
