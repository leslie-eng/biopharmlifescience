# Biolinks storefront (Vite build) — place in public_html as .htaccess
# Upload contents of commerce-hub-main/dist/ to public_html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy API to Node.js app (adjust port/path if your host uses a subdomain for API instead)
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteRule ^ - [L]

  # SPA: serve index.html for client routes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
