# cPanel → Setup Node.js App → Environment variables

PORT=3001
NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_biolinks
DB_PASSWORD=
DB_NAME=cpaneluser_biolinks

JWT_SECRET=
PUBLIC_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

UPLOAD_DIR=/home/YOUR_CPANEL_USER/biolinks-api/uploads

# Optional: serve Vite build from the same Node process (single-app deploy)
# STATIC_DIR=/home/YOUR_CPANEL_USER/biolinks-api/public
