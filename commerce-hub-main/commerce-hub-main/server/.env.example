# Copy to .env and fill in cPanel MySQL credentials (cPanel → MySQL Databases)
PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_cpanel_db_name

# Long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret

# Public URL of this API (no trailing slash). On cPanel: https://yourdomain.com/api
PUBLIC_URL=http://localhost:3001

# Comma-separated origins for CORS (frontend URL)
CORS_ORIGIN=http://localhost:8080,https://yourdomain.com

# Folder for uploaded product images (must be writable)
UPLOAD_DIR=./uploads

# Optional: serve production Vite build from this folder (same-origin /api)
# STATIC_DIR=./public

# Optional: visitor chatbot RAG (better answers with OpenAI; works without key using retrieval-only)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# CSV import (npm run import:csv) — see server/import-data/
# IMPORT_DATA_DIR=./import-data
# IMPORT_DEFAULT_PASSWORD=ChangeMeAfterImport1
