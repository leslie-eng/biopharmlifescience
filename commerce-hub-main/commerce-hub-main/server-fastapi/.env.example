# --- Database ---
# Full SQLAlchemy URL (preferred). Example for a local Postgres:
DATABASE_URL=postgresql+psycopg2://biolinks_user:changeme@localhost:5432/biolinks
# If DATABASE_URL is not set, these discrete vars are assembled into one instead:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=biolinks_user
# DB_PASSWORD=changeme
# DB_NAME=biolinks

# --- Auth ---
# REQUIRED. No hardcoded fallback — the app refuses to start without this.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:8080

# --- Uploads ---
UPLOAD_DIR=./uploads
# Public base URL prefixed onto returned upload URLs, e.g. https://api.biopharmlifescience.com
PUBLIC_URL=

# --- Optional: serve a built frontend from this same process (usually left unset on cPanel) ---
STATIC_DIR=

# --- Chat / RAG ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Server (local dev only; cPanel/Passenger ignores this) ---
PORT=3001
