# --- Database ---
# Full SQLAlchemy URL (preferred). Example for a local Postgres:
DATABASE_URL=postgresql+psycopg2://biolinks_user:changeme@localhost:5432/biolinks
# If DATABASE_URL is not set, these discrete vars are assembled into one instead:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=biolinks_user
# DB_PASSWORD=changeme
# DB_NAME=biolinks

# --- Auth ---
# REQUIRED, at least 32 characters. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:8080

# --- Uploads ---
UPLOAD_DIR=./uploads
# Public base URL prefixed onto returned upload URLs, e.g. https://api.biopharmlifescience.com
PUBLIC_URL=

# --- Chat / RAG ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Server ---
PORT=3001

# --- API docs: set true locally to browse /docs; leave false in staging/production ---
EXPOSE_API_DOCS=false

# --- Proxy ---
# true on Render: rate limits key on the client IP that Render's proxy appends to X-Forwarded-For.
TRUST_PROXY=false

# --- Error monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
